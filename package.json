{
  "name": "dsh-folder",
  "version": "0.1.0",
  "description": "DSH workspace context menu plugin: adds \"Open Folder\" between Rename and Delete Workspace",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workspace",
    "folder"
  ],
  "license": "MIT"
}
